{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["$app/types", "node", "chrome"]
  },
  "include": ["src", "tests", "*"]
}
