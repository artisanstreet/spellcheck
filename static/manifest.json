{
  "manifest_version": 3,
  "name": "Spellcheck by Artisan Street",
  "version": "0.1.0",
  "description": "Context-aware spelling and grammar checking that runs entirely on your device.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "index.html#/popup",
    "default_title": "Spellcheck by Artisan Street"
  },
  "options_ui": {
    "page": "index.html#/options",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
